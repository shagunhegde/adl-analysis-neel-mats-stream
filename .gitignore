# Full 128-position tensor dumps (~341MB each). Regenerate with scripts/reproduce.sh;
# every file is hashed in artifacts/RUN_MANIFEST.json / sha256sums.txt.
# The committed subsets are artifacts/core/ and artifacts/neutral/core/ (the paper's
# k=5 positions, byte-identical to what upstream wrote).
artifacts/raw/
artifacts/neutral/raw/
artifacts/penguin/raw/

# Never commit the grader key
openrouter_api_key.txt

# Local scratch that is not part of the reproduction
__pycache__/
*.pyc
.venv-analysis/
.DS_Store

# reproduce_all.sh writes here; the archived artifacts/ are never touched
reproduction/

# Corpora and adapters are regenerated by `reproduce_all.sh data students`
# (deterministic given the seeds in docs/06); ~550 MB of LoRA weights and
# ~250 MB of JSONL do not belong in git.
data/
students/
